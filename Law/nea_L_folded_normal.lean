set_option linter.unusedSectionVars false

namespace NEA.FoldedNormal

-- √(2/π) 的数值: 0.7978845608...
-- 用有理数验证: 79/100 < √(2/π) < 81/100
-- 等价于: 79²/100² < 2/π < 81²/100²
-- 等价于: 79²π < 20000 < 81²π
-- 用 π 的界: 3.14159 < π < 3.14160
--   79² · 3.14159 = 6241 · 3.14159 ≈ 19605.7 < 20000 ✓
--   81² · 3.14160 = 6561 · 3.14160 ≈ 20612 > 20000 ✓

-- 整数形式 (乘 10^5):
-- 79² · 314159 = 6241 · 314159 = 1960594919 < 2000000000 ✓
-- 81² · 314160 = 6561 · 314160 = 2061431760 > 2000000000 ✓

def sq (n : Nat) : Nat := n * n

theorem lower_bound :
    sq 79 * 314159 < 2000000000 := by decide

theorem upper_bound :
    2000000000 < sq 81 * 314160 := by decide

/-- 结论: 79/100 < √(2/π) < 81/100 (用 3.14159 < π < 3.14160) -/
theorem sqrt_2_over_pi_in_interval :
    sq 79 * 314159 < 2000000000 ∧
    2000000000 < sq 81 * 314160 :=
  ⟨lower_bound, upper_bound⟩

/-- 交叉验证: 79·79 = 6241, 81·81 = 6561 -/
theorem sq_values :
    sq 79 = 6241 ∧ sq 81 = 6561 := by decide

end NEA.FoldedNormal
